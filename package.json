{
  "name": "coralize",
  "displayName": "Coralize",
  "description": "轻巧的中国风工作区配色：点选传统色，按色系随机，独立设置标题栏、活动栏与状态栏。",
  "version": "2.0.0",
  "publisher": "sunzhongyi",
  "icon": "resources/coralize.png",
  "engines": {
    "vscode": "^1.78.0"
  },
  "repository": "https://github.com/joisun/coralize",
  "categories": [
    "Other"
  ],
  "keywords": [
    "Theme",
    "Colors",
    "window Color",
    "Workspace Color",
    "Title Bar",
    "Status Bar",
    "Activity Bar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "coralize.open", "title": "打开配色", "category": "Coralize", "icon": "$(color-mode)" },
      { "command": "coralize.setColor", "title": "设置工作区颜色", "category": "Coralize" },
      { "command": "coralize.reset", "title": "清空工作区配色", "category": "Coralize", "icon": "$(discard)" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coralize-view",
          "title": "Coralize",
          "icon": "resources/coralize.svg"
        }
      ]
    },
    "views": {
      "coralize-view": [
        {
          "type": "webview",
          "id": "coralize-view",
          "name": "配色"
        }
      ]
    },
    "configuration": {
      "title": "Coralize",
      "scope": "window",
      "properties": {
        "coralize.color": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Workspace color as a 3- or 6-digit HEX. Applying a color replaces all workspace color customizations; null clears them when changed."
        },
        "coralize.applyToTitleBar": {
          "type": "boolean",
          "default": true,
          "description": "Color the title bar. Requires a custom title bar on platforms that use native window decorations."
        },
        "coralize.applyToSideBar": {
          "type": "boolean",
          "default": false,
          "description": "Color the Activity Bar. The legacy setting name is retained; this does not color the Side Bar."
        },
        "coralize.applyToStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Color the status bar. Debugging colors remain controlled by the theme."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm test",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.78.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "eslint": "^8.39.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.4",
    "@vscode/test-electron": "^2.3.0"
  }
}
